DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Required when accessing via IP:port (e.g. http://103.29.60.233:8030).
# If empty, origins are auto-built from ALLOWED_HOSTS + APP_PORTS (8000, 8030).
# CSRF_TRUSTED_ORIGINS=http://103.29.60.233:8030
# APP_PORTS=8000,8030

# Serve uploaded files (avatars, attachments) when DEBUG=False.
# Prefer nginx/IIS for production; set SERVE_MEDIA=True only for small deployments.
SERVE_MEDIA=False

# Database (PostgreSQL — local install)
DB_NAME=genesis_design
DB_USER=genesis_admin
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=5432

# Optional: superuser URL only if you need python manage.py setup_postgres
# POSTGRES_ADMIN_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/postgres

REDIS_URL=redis://localhost:6379/0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@genesisdesign.local
